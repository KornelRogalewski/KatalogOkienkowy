                       Text="0"
                       FontSize="14" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0">
            <TextBlock Text="Wartość magazynu: "
                       FontSize="14"
                       FontWeight="Bold" />
