<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000">
    <!-- Nowy layout -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" 
            Text="Katalog produktów"
            FontSize="24" 
            FontWeight="Bold" />
        <Button Grid.Row="0" Grid.Column="1" 
                Content="Odśwież" Width="100" />
        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="Tu pojawi się lista produktów"
                   FontSize="18" 
                   Margin="0,10,0,0"/>
        <StackPanel Grid.Row="2" Grid.Column="0" 
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <TextBlock Text="Produktów: "
                    FontSize="14" FontWeight="Bold" />
            <TextBlock x:Name="EtykietaLiczbaProduktow" 
                   Text="0" 
                   FontSize="14" 
                   Margin="0,0,10,0"/>
            <TextBlock Text="Łączna wartość: "
                   FontSize="14" FontWeight="Bold" />
            <TextBlock x:Name="EtykietaWartoscMagazynu" 
                   Text="0" 
                   FontSize="14" 
                   Margin="0,0,10,0"/>
            <Button Content="Dodaj" Width="100" Margin="0,0,10,0" />
            <Button Content="Usuń" Width="100" Margin="0,0,10,0" />
            <Button Content="Zamknij" Width="100"/>
        </StackPanel>
    </Grid>
