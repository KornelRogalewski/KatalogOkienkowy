<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogOkienkowy"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000">
    <StackPanel Margin="20">
        <TextBlock x:Name="Glownystackpanel"
                   Text="Katalog Produktów"
                   FontSize="24"
                   FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0">
            <TextBlock Text="Produktów: "
                       FontSize="14" />
            <TextBlock x:Name="EtykietaLiczbyProduktów"
                       Text="0"
                       FontSize="14" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0, 10, 0, 0">
            <TextBlock Text="Wartość magazynu: "
                       FontSize="14" />
            <TextBlock x:Name="EtykietaWartosciMagazynu"
                       Text="0"
                       FontSize="14" />
        </StackPanel>
        <Button HorizontalAlignment="Center" Padding="5">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Images/plus.png" Width="10" Height="10" Margin="10" />
                <TextBlock Text="Podaj produkt"
                       FontSize="14"
                       FontWeight="Bold" />
                
                
            </StackPanel>
        </Button>

    </StackPanel>
</Window>
